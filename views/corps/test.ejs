<!DOCTYPE html>

<html>
    <head>
        <meta charset="UTF-8"/>

        <title>Meeting Minutes</title>

        <script src="/javascript/popups.js"></script>

        <link rel="stylesheet" href="/css/global.css">
        <link rel="stylesheet" href="/css/corps.css">
        <link rel="stylesheet" href="/css/popup.css">

        <link rel="stylesheet" href="/css/corps/test.css">
    </head>
    <body>
        <header>
            <h1>Test Corp.</h1>
            <h2>Test Corp. is not a real corperation, it was created to test this website</h2>
        </header>

        <section>
            <aside>
                <%- include('../resources/navpanel') -%>
            </aside>

            <div class="content">
                <div class="elements-wrapper">
                    <div class="upload" id="upload" onclick="open_popup()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="50" height="50" fill="currentColor" class="bi bi-cloud-upload" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M4.406 1.342A5.53 5.53 0 0 1 8 0c2.69 0 4.923 2 5.166 4.579C14.758 4.804 16 6.137 16 7.773 16 9.569 14.502 11 12.687 11H10a.5.5 0 0 1 0-1h2.688C13.979 10 15 8.988 15 7.773c0-1.216-1.02-2.228-2.313-2.228h-.5v-.5C12.188 2.825 10.328 1 8 1a4.53 4.53 0 0 0-2.941 1.1c-.757.652-1.153 1.438-1.153 2.055v.448l-.445.049C2.064 4.805 1 5.952 1 7.318 1 8.785 2.23 10 3.781 10H6a.5.5 0 0 1 0 1H3.781C1.708 11 0 9.366 0 7.318c0-1.763 1.266-3.223 2.942-3.593.143-.863.698-1.723 1.464-2.383"/>
                            <path fill-rule="evenodd" d="M7.646 4.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 5.707V14.5a.5.5 0 0 1-1 0V5.707L5.354 7.854a.5.5 0 1 1-.708-.708z"/>
                        </svg>
                    </div>

                    <script>
                        (async () => {
                            const userData = await getUserData();
                            if (!userData) return;

                            if (userData.loggedIn !== true) return;

                            const userAccess = userData.access;
                            if (userAccess.includes('test')) {
                                document.getElementById('upload').style.display = 'flex';
                            }

                        })();
                    </script>

                    <div class="information">
                        <div class="details">
                            <h3>Last Meeting Date: <%= lastmeet %></h3>
                        </div>

                        <div class="details">
                            <h4>Meeting Time: <%= time %></h4>
                            <h4>Meeting Day: <%= day %></h4>
                            <h4>Meeting Location: <%= location %></h4>
                        </div>
                    </div>
                </div>

                <div class="minutes">
                    <% const sortedMinutes = [...minutes].sort((a, b) => new Date(b.date) - new Date(a.date)); %>
                    <% sortedMinutes.forEach(function(item) { %>
                        <div class="minute-row">
                            <h2><%= item.date %></h2>
                            <p><%= item.summary %></p>

                            <a href="<%= item.fileUrl %>" download>
                                Download
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="bi bi-download" viewBox="0 0 16 16">
                                    <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"/>
                                    <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"/>
                                </svg>
                            </a>
                        </div>
                    <% }); %>
                </div>
            </div>
        </section>


        <!-- Upload -->
        <div class="popup-backdrop" id="popup-backdrop">
            <div class="popup-box">
                <h2>Add Minutes</h2>
                <form action="http://localhost:3000/api/add-minutes/test" method="POST" enctype="multipart/form-data">
                    <div>
                        <label for="dateInput">Date</label>
                        <input type="date" name="dateInput"></input>
                    </div>

                    <div>
                        <label for="summary">Summary: </label>
                        <textarea name="summary"></textarea>
                    </div>

	                <input type="file" id="fileUpload" name="fileUpload" class="fileInput" required>
	                <input type="submit" class="submitInput" value="Submit">
                </form>
                <button onclick="close_popup()">Close</button>
            </div>
        </div>


    </body>
</html>